{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bitwage Partner API",
  "colors": {
    "primary": "#0066FF",
    "light": "#3388FF",
    "dark": "#0044CC"
  },
  "favicon": "/images/favicon.png",
  "navigation": {
    "products": [
      {
        "product": "Partner API",
        "description": "Manage users, companies, payroll, and payments.",
        "icon": "money-check-dollar",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Getting started",
                "pages": [
                  "index",
                  "quickstart",
                  "guides/authentication"
                ]
              },
              {
                "group": "Concepts",
                "pages": [
                  "guides/terminology",
                  "guides/private-label",
                  "guides/webhooks",
                  "guides/idempotency"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "openapi": "api-reference/openapi.yaml"
          }
        ]
      },
      {
        "product": "USDb Stablecoin",
        "description": "Mint, burn, and manage USDb stablecoin wallets.",
        "icon": "coins",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Getting started",
                "pages": [
                  "usdb/introduction",
                  "usdb/quickstart",
                  "usdb/authentication"
                ]
              },
              {
                "group": "Concepts",
                "pages": [
                  "usdb/concepts",
                  "usdb/mint-and-burn",
                  "usdb/balance-accounts",
                  "usdb/contract-addresses",
                  "usdb/webhooks"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "openapi": "usdb/openapi.yaml"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://app.bitwage.com",
          "icon": "gauge"
        },
        {
          "anchor": "Website",
          "href": "https://www.bitwage.com",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/bitwage-logo.svg",
    "dark": "/images/bitwage-logo-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
